<html>
  <title>Tarefas - teste técnico</title>

  <body>
    <h1>Tarefas</h1>

    <table border="1">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Custo (R$)</th>
          <th>Data</th>
          <th>Ordem</th>
        </tr>
        <tbody>
          <% @tarefas.each do |tarefa| %>
          <tr>
            <td><%= tarefa.nometarefa %></td>
            <td><%= tarefa.custo %></td>
            <td><%= tarefa.data %></td>
            <td><%= link_to "Detalhes", tarefa_path(tarefa) %></td>

          </tr>
        <% end %>
        </tbody>
      </thead>
    </table>
    <!-- <p>Find me in app/views/tarefas/index.html.erb</p> -->
    <br>

  </body>

</html>


