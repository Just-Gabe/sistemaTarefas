<h1>Nova Tarefa</h1>

<%= form_with model: @tarefa do |form| %>
  <div>
    <%= form.label :nometarefa, "Nome da Tarefa" %><br>
    <%= form.text_field :nometarefa %>
  </div>

  <div>
    <%= form.label :custo, "Custo (R$)" %><br>
    <%= form.number_field :custo, step: 0.01 %>
  </div>

  <div>
    <%= form.label :data, "Data Limite" %><br>
    <%= form.date_field :data %>
  </div>

  <br>
  <div>
    <%= form.submit "Salvar Tarefa" %>
  </div>
<% end %>

<br>
<%= link_to "Voltar", tarefas_path %>
